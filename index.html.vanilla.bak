  <!-- ==================== MODALS ==================== -->

  <!-- 1. Fullscreen Shayari Reader Modal -->
  <div class="modal-backdrop" id="reader-modal" aria-hidden="true" role="dialog">
    <div class="reader-modal-sheet" id="reader-modal-sheet">
      <!-- Modal Header -->
      <div class="reader-modal-header">
        <div class="reader-meta">
          <span class="reader-mood-pill" id="reader-mood">इश्क़</span>
          <span class="reader-id-pill" id="reader-id">#01</span>
          <h2 class="reader-title" id="reader-title">मेरा रब फरमाता है</h2>
        </div>
        <div class="reader-header-actions">
          <button class="modal-icon-btn btn-modal-wa" id="reader-wa-btn" title="व्हाट्सएप पर शेयर करें">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M20.5 3.5A11.9 11.9 0 0 0 12 0C5.4 0 0 5.4 0 12c0 2.1.6 4.2 1.6 6L0 24l6.2-1.6A11.9 11.9 0 0 0 12 24c6.6 0 12-5.4 12-12 0-3.2-1.3-6.2-3.5-8.5ZM12 22a9.9 9.9 0 0 1-5.1-1.4l-.4-.2-3.8 1 1-3.7-.2-.4A9.9 9.9 0 1 1 22 12c0 5.5-4.5 10-10 10Zm5.4-7.4c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.1s-.8 1-.9 1.2c-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.2.3-.4.4-.6.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5s-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4s-1.2 1.2-1.2 2.8c0 1.6 1.2 3.2 1.4 3.4.2.2 2.4 3.7 5.8 5.1.8.4 1.4.6 1.9.7.8.3 1.6.2 2.2.1.7-.1 1.8-.7 2-1.4.3-.7.3-1.4.2-1.5-.1-.1-.3-.2-.6-.4Z"/></svg>
          </button>
          <button class="modal-icon-btn btn-modal-fav" id="reader-fav-btn" title="पसंदीदा (Bookmark)">
            <svg class="heart-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          </button>
          <button class="modal-icon-btn" id="reader-share-btn" title="इंस्टाग्राम स्टोरी कार्ड बनाएं">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect width="18" height="18" x="3" y="3" rx="4"/><circle cx="12" cy="12" r="3.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
          </button>
          <button class="modal-icon-btn" id="reader-close-btn" title="बंद करें (Esc)">
            <span>✕</span>
          </button>
        </div>
      </div>

      <!-- Modal Body -->
      <div class="reader-modal-body">
        <!-- Handwritten Image Area -->
        <div class="reader-image-card">
          <div class="image-wrapper" id="reader-image-wrapper">
            <img id="reader-image" src="" alt="Handwritten Shayari by Shazo" loading="lazy">
            <div class="image-paper-overlay"></div>
          </div>
          <div class="image-zoom-hint">दबाकर बड़ा करें / Double tap to inspect</div>
        </div>

        <!-- Voice Mode Bar (Audio Player & AI Auto-Reader) -->
        <div class="reader-voice-section" id="reader-voice-section">
          <div class="voice-header-row">
            <div class="voice-title-col">
              <span class="voice-badge">🎙️ Voice Mode</span>
              <span class="voice-sub" id="voice-artist">शारजो की शायरी सुनें</span>
            </div>

            <!-- Voice Source Toggle (AI vs Real Voice) -->
            <div class="voice-mode-toggle-group">
              <button class="voice-mode-pill active" id="btn-mode-ai" title="ब्राउज़र द्वारा अपने आप सुनाएं (AI TTS)">
                <span>✨ AI पाठ</span>
              </button>
              <button class="voice-mode-pill" id="btn-mode-real" title="शारजो की असली आवाज़">
                <span>🎙️ असली आवाज़</span>
              </button>
            </div>

            <div class="voice-autoplay-toggle">
              <label class="toggle-switch">
                <input type="checkbox" id="voice-autoplay-next" checked>
                <span class="toggle-slider"></span>
              </label>
              <span class="toggle-label">अगला अपने-आप (Auto-Next)</span>
            </div>
          </div>

          <!-- Player Controls -->
          <div class="voice-player-bar" id="voice-player-bar">
            <button class="voice-play-circle" id="voice-play-circle" aria-label="Play Voice Recording">
              <span class="play-symbol" id="voice-play-symbol">▶</span>
            </button>

            <div class="voice-track-info">
              <!-- Live Visualizer / Waveform -->
              <div class="waveform-container" id="waveform-container">
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
                <div class="wave-bar"></div>
              </div>

              <!-- Progress Scrubber & Rate Pills -->
              <div class="progress-wrapper">
                <input type="range" class="voice-scrubber" id="voice-scrubber" min="0" max="100" value="0" step="0.1">
                <div class="time-row">
                  <span class="time-curr" id="voice-time-curr">0:00</span>
                  <div class="speed-control-group">
                    <span class="speed-label">रफ़्तार:</span>
                    <button class="speed-chip active" id="speed-chip-slow" data-rate="0.85">0.85x शायराना</button>
                    <button class="speed-chip" id="speed-chip-norm" data-rate="1.0">1.0x</button>
                  </div>
                  <span class="time-dur" id="voice-time-dur">AI पाठ</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Dynamic Status / Helper Message -->
          <div class="voice-status-box" id="voice-status-box">
            <span class="status-icon">✨</span>
            <span class="status-text" id="voice-status-text">
              यदि आप पढ़ना नहीं चाहते, तो <strong>प्ले (▶) बटन</strong> दबाएं — यह शेर आपके लिए अपने आप पढ़ा जाएगा।
            </span>
          </div>
        </div>

        <!-- Transcribed Text Area (Typed text beside / below image) -->
        <div class="reader-text-section" id="reader-text-section">
          <div class="text-section-header">
            <span class="text-label">📜 मुद्रित तहरीर (Typed Text)</span>
            <button class="copy-text-btn" id="reader-copy-text-btn">
              <span>📋</span> <span id="copy-text-label">नक़ल करें (Copy)</span>
            </button>
          </div>
          <div class="typed-text-box" id="reader-typed-text">
            <!-- Transcribed Hindi text -->
          </div>
        </div>
      </div>

      <!-- Modal Bottom Navigation (Prev / Next) -->
      <div class="reader-modal-footer">
        <button class="nav-prev-btn" id="reader-prev-btn">
          <span class="arrow">←</span> पिछला शेर
        </button>
        <span class="footer-counter" id="reader-counter">1 / 59</span>
        <button class="nav-next-btn" id="reader-next-btn">
          अगला शेर <span class="arrow">→</span>
        </button>
      </div>
    </div>
  </div>

